# Copy this file to terraform.tfvars and fill in your own values.
# Never commit terraform.tfvars or credentials.

cloud_id             = "YOUR_YANDEX_CLOUD_ID"
folder_id            = "YOUR_YANDEX_FOLDER_ID"
zone                 = "ru-central1-d"
subnet_id            = "YOUR_EXISTING_SUBNET_ID"
ssh_public_key_path  = "~/.ssh/id_ed25519.pub"
vm_name              = "devops-final-vm"
ssh_allowed_cidr     = "YOUR_PUBLIC_IP/32"
